# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL via Supabase)
DB_HOST=your-db-host.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-db-password
DB_DATABASE=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-separate-refresh-secret-min-32-chars
JWT_EXPIRATION=15m
REFRESH_COOKIE_SAMESITE=lax

# CORS
FRONTEND_URL=http://localhost:5173

# User defaults
DEFAULT_AVATAR_URL=https://your-cdn.example.com/default-avatar.jpg

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login/callback

# Upload
UPLOAD_DIR=./uploads

# Facebook Sync (Optional)
FB_SYNC_ENABLED=false
FB_SYNC_INTERVAL_MINUTES=5
FB_GRAPH_VERSION=v19.0
FB_APP_ID=your-fb-app-id
FB_PAGE_ID=your-fb-page-id
FB_PAGE_ACCESS_TOKEN=your-fb-page-access-token
FB_WEBHOOK_ENABLED=false
FB_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
FB_WEBHOOK_CALLBACK_URL=https://your-domain.com/api/v1/facebook/webhook
FB_APP_SECRET=your-fb-app-secret
FB_BOT_EMAIL=bot@your-domain.com
FB_BOT_USERNAME=your_bot
FB_BOT_NAME=Your Bot Name
FB_BOT_PASSWORD=your-bot-password

# Cloudinary (Image upload)
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Gemini AI (Optional - for AI features)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Dify AI (Optional - for chatbot)
DIFY_API_URL=https://api.dify.ai/v1
DIFY_CAPTION_CHATBOT_KEY=app-your-app-id
DIFY_GENERAL_API_KEY=app-your-api-key
DIFY_CHATBOT_API_KEY=app-your-chatbot-api-key

# AI Tool Key
AI_TOOL_KEY=your-ai-tool-secret-key
